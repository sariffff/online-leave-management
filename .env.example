# คัดลอกเป็น .env.local (เครื่องตัวเอง) หรือใส่ใน Vercel → Settings → Environment Variables

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามเปิดเผย
SUPABASE_SERVICE_ROLE_KEY=

# (ไม่บังคับ) แหล่งวันหยุดราชการ .ics — เว้นว่าง = ปฏิทินวันหยุดไทยของ Google
HOLIDAY_ICS_URL=

# (ไม่บังคับ) 1 = แสดงเวลาที่ใช้ของแต่ละ API ใน log
PERF_LOG=
